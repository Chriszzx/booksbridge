<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>BooksBridge</string>
    <key>CFBundleDisplayName</key>
    <string>BooksBridge</string>
    <key>CFBundleIdentifier</key>
    <string>com.chris.booksbridge</string>
    <key>CFBundleExecutable</key>
    <string>BooksBridgeApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!--
      菜单栏 + Dock 图标。
      注意：LSUIElement 必须为 false —— 为 true 时应用不进 Dock，也无法成为
      普通前台应用，用户很难在「系统设置 → 隐私与安全性」列表里找到它来授权。
      窗口隐藏后应用仍常驻菜单栏，不会占用 Dock 空间（隐藏时用 NSApp.hide）。
    -->
    <key>LSUIElement</key>
    <false/>

    <!--
      辅助功能权限的用途说明。
      缺这个键时，AXIsProcessTrustedWithOptions 的引导弹窗不会出现，
      用户只能自己去系统设置里手动添加，体验很差。
    -->
    <key>NSAccessibilityUsageDescription</key>
    <string>BooksBridge 需要读取图书 App 窗口内当前可见的正文与你划选的文字，用于组装提问时的书籍上下文。</string>

    <key>NSHumanReadableCopyright</key>
    <string>本地自用，未分发</string>
</dict>
</plist>
